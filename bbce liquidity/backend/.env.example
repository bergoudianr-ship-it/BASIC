# Copie para `.env` e preencha. NUNCA faça commit do .env com valores reais.
# (O .env está no .gitignore.)

# 'mock' serve a base de exemplo embutida (sem credenciais).
# 'live' autentica na BBCE e busca os negócios ao vivo.
BBCE_MODE=mock

# --- necessário apenas no modo live ---
BBCE_BASE_URL=https://api-beta.qa.bbce.tech/bus
BBCE_API_KEY=
BBCE_COMPANY_CODE=
BBCE_EMAIL=
BBCE_PASSWORD=

# De onde vêm os negócios — use UMA das formas abaixo:
# (a) endpoint único que já devolve TODOS os negócios (se a BBCE tiver):
BBCE_TRADES_PATH=
# (b) enumerar os tickers da(s) carteira(s) e buscar negotiation-data de cada.
#     Informe o(s) walletId(s) (retornados em /wallets, ex.: 2). RECOMENDADO.
BBCE_WALLET_IDS=
# (c) lista fixa de tickers, se quiser restringir (ex.: 4221,5489). Opcional.
BBCE_TICKER_IDS=

# caminhos dos endpoints (padrões já corretos; mude só se a BBCE alterar):
BBCE_WALLETS_PATH=/wallets
BBCE_TICKERS_PATH=/v1/negotiable-tickers
BBCE_NEGOTIATION_PATH=/v1/negotiation-data/{tickerId}
# pausa em segundos entre chamadas por ticker (respeita o rate limit; ex.: 0.2)
BBCE_REQUEST_DELAY=0

# --- servidor ---
BBCE_HOST=127.0.0.1
BBCE_PORT=8787
# origem permitida no CORS ('*' serve para uso local; restrinja se hospedar num domínio fixo)
BBCE_CORS_ORIGIN=*
