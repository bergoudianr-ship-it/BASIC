# Copie para .env e preencha. NUNCA faça commit do .env com valores reais.
# (O .env está no .gitignore.)

# Modos:
#   mock -> base de exemplo (sem nada configurado)
#   csv  -> lê um CSV local (SharePoint sincronizado). Sem API/credenciais. RECOMENDADO.
#   live -> puxa direto da API BBCE de produção (precisa das credenciais abaixo).
BBCE_MODE=mock

# --- modo csv (recomendado) ---
# Caminho do CSV que o seu pipeline grava (pasta do OneDrive/SharePoint sincronizada).
BBCE_CSV_PATH=
# Codificação do CSV: utf-8-sig (padrão do seu pipeline) ou latin-1 (export da BBCE).
BBCE_CSV_ENCODING=utf-8-sig

# --- credenciais (necessárias APENAS no modo live) ---
# Se você colocar o seu pega_negociacoes_bbce.py nesta pasta, o backend lê as
# credenciais dele automaticamente e você pode deixar os 4 campos abaixo em branco.
BBCE_BASE_URL=https://api-ehub.bbce.com.br/bus
BBCE_API_KEY=
BBCE_USERNAME=
BBCE_PASSWORD=
BBCE_COMPANY_ID=1266

# --- janela de dados e atualização ---
# 1º arranque puxa BACKFILL_DAYS de histórico; depois, os últimos REFRESH_DAYS.
BBCE_BACKFILL_DAYS=180
BBCE_REFRESH_DAYS=3
BBCE_REFRESH_SECONDS=600
# opcional: filtrar por tipo de operação (ex.: Negócio/Balcão). Vazio = todos.
BBCE_ORIGIN_OPERATION_TYPE=

# --- servidor ---
BBCE_HOST=127.0.0.1
BBCE_PORT=8787
BBCE_CORS_ORIGIN=*
