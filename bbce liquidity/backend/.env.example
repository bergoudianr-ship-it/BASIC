# Copie para `.env` e preencha. NUNCA faça commit do .env com valores reais.
# (O .env está no .gitignore.)

# 'mock' serve a base de exemplo embutida (sem credenciais).
# 'live' autentica na BBCE e busca os negócios ao vivo.
BBCE_MODE=mock

# --- necessário apenas no modo live ---
BBCE_BASE_URL=https://api-beta.qa.bbce.tech/bus
BBCE_API_KEY=
BBCE_COMPANY_CODE=
BBCE_EMAIL=
BBCE_PASSWORD=
# caminho do endpoint de negócios executados (a confirmar na doc do grupo Orders/Trades)
BBCE_TRADES_PATH=

# --- servidor ---
BBCE_HOST=127.0.0.1
BBCE_PORT=8787
# origem permitida no CORS ('*' serve para uso local; restrinja se hospedar num domínio fixo)
BBCE_CORS_ORIGIN=*
