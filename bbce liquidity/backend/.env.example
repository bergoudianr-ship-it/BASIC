# Copie para `.env` e preencha. NUNCA faça commit do .env com valores reais.
# (O .env está no .gitignore.)

# 'mock' serve a base de exemplo embutida (sem credenciais).
# 'live' autentica na BBCE e busca os negócios ao vivo.
BBCE_MODE=mock

# --- necessário apenas no modo live ---
BBCE_BASE_URL=https://api-beta.qa.bbce.tech/bus
BBCE_API_KEY=
BBCE_COMPANY_CODE=
BBCE_EMAIL=
BBCE_PASSWORD=

# De onde vêm os negócios — use UMA das duas formas:
# (a) um endpoint que já devolve TODOS os negócios de uma vez (se a BBCE tiver):
BBCE_TRADES_PATH=
# (b) busca por ticker via /v1/negotiation-data/{tickerId} e junta os resultados.
#     Liste os IDs separados por vírgula (ex.: 4221,5489,...). Deixe (a) vazio se usar (b).
BBCE_NEGOTIATION_PATH=/v1/negotiation-data/{tickerId}
BBCE_TICKER_IDS=

# --- servidor ---
BBCE_HOST=127.0.0.1
BBCE_PORT=8787
# origem permitida no CORS ('*' serve para uso local; restrinja se hospedar num domínio fixo)
BBCE_CORS_ORIGIN=*
